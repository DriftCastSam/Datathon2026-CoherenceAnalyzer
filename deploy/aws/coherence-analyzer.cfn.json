{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "CoherenceAnalyzer AWS footprint (SPEC section 14): S3 store bucket, Bedrock Guardrail for the explainer call only, least-privilege IAM managed policy. Educational simulation, no execution.",
  "Parameters": {
    "ModelArn": {
      "Type": "String",
      "Description": "ARN of the Bedrock model or inference profile used for BEDROCK_MODEL_ID. bedrock:InvokeModel is granted on this ARN only.",
      "AllowedPattern": "arn:aws[a-z-]*:bedrock:.+"
    },
    "S3Prefix": {
      "Type": "String",
      "Default": "ca/",
      "Description": "Key prefix the app may read and write, with a trailing slash (the app setting COHERENCE_ANALYZER_S3_PREFIX is the same value without the slash).",
      "AllowedPattern": "([A-Za-z0-9_.-]+/)*"
    }
  },
  "Resources": {
    "DataBucket": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "VersioningConfiguration": {
          "Status": "Enabled"
        },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "BucketKeyEnabled": true,
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "OwnershipControls": {
          "Rules": [
            {
              "ObjectOwnership": "BucketOwnerEnforced"
            }
          ]
        }
      }
    },
    "DataBucketPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "DataBucket"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "DenyNonTlsRequests",
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                {
                  "Fn::GetAtt": ["DataBucket", "Arn"]
                },
                {
                  "Fn::Sub": "${DataBucket.Arn}/*"
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            }
          ]
        }
      }
    },
    "ExplainerGuardrail": {
      "Type": "AWS::Bedrock::Guardrail",
      "Properties": {
        "Name": "coherence-analyzer-explainer",
        "Description": "Applied to the explainer call only. Denies personalised investment recommendations.",
        "BlockedInputMessaging": "Cette demande ne peut pas être traitée : l'outil ne donne pas de conseil en placement personnalisé. This request cannot be processed: the tool gives no personalised investment advice.",
        "BlockedOutputsMessaging": "Cette réponse a été bloquée : l'outil ne donne pas de conseil en placement personnalisé. This answer was blocked: the tool gives no personalised investment advice.",
        "TopicPolicyConfig": {
          "TopicsConfig": [
            {
              "Name": "Personalised-investment-recommendations",
              "Type": "DENY",
              "Definition": "Telling a person what to buy, sell or hold, or how to invest their own money, as a personalised investment recommendation.",
              "Examples": [
                "Devrais-je acheter de l'action NVDA avec mes économies ?",
                "Quel FNB dois-je vendre dans mon portefeuille ?",
                "Je te conseille d'acheter plus d'actions, qu'en penses-tu ?",
                "Should I buy NVDA with my savings?",
                "Which ETF should I sell in my portfolio? I recommend you pick one."
              ]
            }
          ]
        }
      }
    },
    "ExplainerGuardrailVersion": {
      "Type": "AWS::Bedrock::GuardrailVersion",
      "Properties": {
        "GuardrailIdentifier": {
          "Fn::GetAtt": ["ExplainerGuardrail", "GuardrailId"]
        },
        "Description": "Immutable version of the explainer guardrail"
      }
    },
    "AppAccessPolicy": {
      "Type": "AWS::IAM::ManagedPolicy",
      "Properties": {
        "Description": "Least-privilege access for CoherenceAnalyzer: invoke one Bedrock model, apply one guardrail, read and write one S3 prefix.",
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "InvokeConfiguredModel",
              "Effect": "Allow",
              "Action": ["bedrock:InvokeModel"],
              "Resource": [
                {
                  "Ref": "ModelArn"
                }
              ]
            },
            {
              "Sid": "ApplyExplainerGuardrail",
              "Effect": "Allow",
              "Action": ["bedrock:ApplyGuardrail"],
              "Resource": [
                {
                  "Fn::GetAtt": ["ExplainerGuardrail", "GuardrailArn"]
                }
              ]
            },
            {
              "Sid": "ReadStoreObjects",
              "Effect": "Allow",
              "Action": ["s3:GetObject"],
              "Resource": [
                {
                  "Fn::Sub": "${DataBucket.Arn}/${S3Prefix}*"
                }
              ]
            },
            {
              "Sid": "WriteStoreObjects",
              "Effect": "Allow",
              "Action": ["s3:PutObject"],
              "Resource": [
                {
                  "Fn::Sub": "${DataBucket.Arn}/${S3Prefix}*"
                }
              ]
            },
            {
              "Sid": "ListStorePrefix",
              "Effect": "Allow",
              "Action": ["s3:ListBucket"],
              "Resource": [
                {
                  "Fn::GetAtt": ["DataBucket", "Arn"]
                }
              ],
              "Condition": {
                "StringLike": {
                  "s3:prefix": [
                    {
                      "Fn::Sub": "${S3Prefix}*"
                    }
                  ]
                }
              }
            }
          ]
        }
      }
    }
  },
  "Outputs": {
    "BucketName": {
      "Description": "Value for COHERENCE_ANALYZER_S3_BUCKET",
      "Value": {
        "Ref": "DataBucket"
      }
    },
    "GuardrailId": {
      "Description": "Value for BEDROCK_GUARDRAIL_ID",
      "Value": {
        "Fn::GetAtt": ["ExplainerGuardrail", "GuardrailId"]
      }
    },
    "GuardrailVersion": {
      "Description": "Value for BEDROCK_GUARDRAIL_VERSION",
      "Value": {
        "Fn::GetAtt": ["ExplainerGuardrailVersion", "Version"]
      }
    },
    "AccessPolicyArn": {
      "Description": "Managed policy to attach to the role or user that runs the app",
      "Value": {
        "Ref": "AppAccessPolicy"
      }
    }
  }
}
