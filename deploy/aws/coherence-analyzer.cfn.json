{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "CoherenceAnalyzer AWS footprint (SPEC section 14): S3 store bucket, Bedrock Guardrail for the explainer call only, least-privilege IAM managed policy. Educational simulation, no execution.",
  "Metadata": {
    "AWSToolsMetrics": {
      "AWSAgentToolkit": "aws-cloudformation@3"
    },
    "com.aws.cloudformation.Context": {
      "DeployFlowB": {
        "why": "Flow B (Step Functions + Lambda) is optional: stack updates without packaged Lambda code keep working.",
        "must": "Only the FlowB* resources and the StateMachineArn output use this condition; the deployed bucket, guardrail and policy never do."
      }
    }
  },
  "Parameters": {
    "ModelArn": {
      "Type": "String",
      "Description": "ARN of the Bedrock model or inference profile used for BEDROCK_MODEL_ID. bedrock:InvokeModel is granted on this ARN and on FoundationModelId.",
      "AllowedPattern": "arn:aws[a-z-]*:bedrock:.+"
    },
    "S3Prefix": {
      "Type": "String",
      "Default": "ca/",
      "Description": "Key prefix the app may read and write, with a trailing slash (the app setting COHERENCE_ANALYZER_S3_PREFIX is the same value without the slash).",
      "AllowedPattern": "([A-Za-z0-9_.-]+/)*"
    },
    "FoundationModelId": {
      "Type": "String",
      "Default": "anthropic.claude-sonnet-5-5",
      "Description": "Foundation model id behind ModelArn. A cross-region inference profile needs bedrock:InvokeModel on this model in every destination Region it routes to.",
      "AllowedPattern": "[a-z0-9.-]+(:[0-9]+)?"
    },
    "LambdaCodeS3Bucket": {
      "Type": "String",
      "Description": "S3 bucket holding the Flow B Lambda zip (coherence_analyzer package, data and its dependencies). See README, AWS deploy. Leave empty to skip the Flow B Lambda and state machine.",
      "Default": ""
    },
    "LambdaCodeS3Key": {
      "Type": "String",
      "Description": "S3 key of the Flow B Lambda zip in LambdaCodeS3Bucket. Leave empty to skip the Flow B Lambda and state machine.",
      "Default": ""
    },
    "BedrockModelId": {
      "Type": "String",
      "Description": "Value of BEDROCK_MODEL_ID for the Flow B Lambda: the model id or inference profile id matching ModelArn.",
      "Default": "us.anthropic.claude-sonnet-5-5"
    }
  },
  "Resources": {
    "DataBucket": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "VersioningConfiguration": {
          "Status": "Enabled"
        },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "BucketKeyEnabled": true,
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "OwnershipControls": {
          "Rules": [
            {
              "ObjectOwnership": "BucketOwnerEnforced"
            }
          ]
        }
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Store backend for COHERENCE_ANALYZER_STORE=s3 (SPEC section 10): profiles, events, reports, audit.",
          "must": [
            "Keep public access blocked, encryption and versioning on",
            "Retain on delete: audit records are evidence"
          ]
        }
      }
    },
    "DataBucketPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "DataBucket"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "DenyNonTlsRequests",
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "DataBucket",
                    "Arn"
                  ]
                },
                {
                  "Fn::Sub": "${DataBucket.Arn}/*"
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            }
          ]
        }
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Encryption in transit for every request.",
          "must": [
            "Deny any request without aws:SecureTransport"
          ]
        }
      }
    },
    "ExplainerGuardrail": {
      "Type": "AWS::Bedrock::Guardrail",
      "Properties": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-explainer"
        },
        "Description": "Applied to the explainer call only. Denies personalised investment recommendations.",
        "BlockedInputMessaging": "Cette demande ne peut pas être traitée : l'outil ne donne pas de conseil en placement personnalisé. This request cannot be processed: the tool gives no personalised investment advice.",
        "BlockedOutputsMessaging": "Cette réponse a été bloquée : l'outil ne donne pas de conseil en placement personnalisé. This answer was blocked: the tool gives no personalised investment advice.",
        "TopicPolicyConfig": {
          "TopicsConfig": [
            {
              "Name": "Personalised-investment-recommendations",
              "Type": "DENY",
              "Definition": "Recommendations addressed to the reader telling them to buy, sell, hold or reallocate a specific investment, or how they personally should invest their money.",
              "Examples": [
                "Vous devriez vendre vos actions NVDA et acheter des obligations.",
                "Je vous recommande d'acheter XBB pour réduire votre risque.",
                "You should sell your NVDA shares and buy more bonds.",
                "We recommend moving 10% of your portfolio into gold.",
                "Buy QQQ now, it is the best choice for your profile."
              ],
              "InputEnabled": false,
              "OutputEnabled": true,
              "OutputAction": "BLOCK"
            }
          ]
        }
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "SPEC section 14: denied topic on the N5 explainer call only. v2 (2026-11-14): v1 blocked factual limit-vs-holding sentences and our own rules text on input; the topic now targets directives and runs on output only.",
          "must": [
            "Never attach to N1, N3, N4 or N6 calls",
            "Blocked messaging stays fixed text, never LLM output"
          ]
        }
      }
    },
    "ExplainerGuardrailVersion": {
      "Type": "AWS::Bedrock::GuardrailVersion",
      "Properties": {
        "GuardrailIdentifier": {
          "Fn::GetAtt": [
            "ExplainerGuardrail",
            "GuardrailId"
          ]
        },
        "Description": "Explainer guardrail v2: denied topic narrowed to directives, evaluated on model output only"
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "The app pins an immutable guardrail version in BEDROCK_GUARDRAIL_VERSION."
        }
      }
    },
    "AppAccessPolicy": {
      "Type": "AWS::IAM::ManagedPolicy",
      "Properties": {
        "Description": "Least-privilege access for CoherenceAnalyzer: invoke one Bedrock model, apply one guardrail, read and write one S3 prefix.",
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "InvokeConfiguredModel",
              "Effect": "Allow",
              "Action": [
                "bedrock:InvokeModel"
              ],
              "Resource": [
                {
                  "Ref": "ModelArn"
                },
                {
                  "Fn::Sub": "arn:${AWS::Partition}:bedrock:*::foundation-model/${FoundationModelId}"
                }
              ]
            },
            {
              "Sid": "ApplyExplainerGuardrail",
              "Effect": "Allow",
              "Action": [
                "bedrock:ApplyGuardrail"
              ],
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "ExplainerGuardrail",
                    "GuardrailArn"
                  ]
                }
              ]
            },
            {
              "Sid": "ReadStoreObjects",
              "Effect": "Allow",
              "Action": [
                "s3:GetObject"
              ],
              "Resource": [
                {
                  "Fn::Sub": "${DataBucket.Arn}/${S3Prefix}*"
                }
              ]
            },
            {
              "Sid": "WriteStoreObjects",
              "Effect": "Allow",
              "Action": [
                "s3:PutObject"
              ],
              "Resource": [
                {
                  "Fn::Sub": "${DataBucket.Arn}/${S3Prefix}*"
                }
              ]
            },
            {
              "Sid": "ListStorePrefix",
              "Effect": "Allow",
              "Action": [
                "s3:ListBucket"
              ],
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "DataBucket",
                    "Arn"
                  ]
                }
              ],
              "Condition": {
                "StringLike": {
                  "s3:prefix": [
                    {
                      "Fn::Sub": "${S3Prefix}*"
                    }
                  ]
                }
              }
            }
          ]
        }
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "One least-privilege policy for whoever runs the app.",
          "must": [
            "No action or resource wildcards beyond the one model id across inference-profile Regions",
            "S3 access limited to the S3Prefix"
          ]
        }
      }
    },
    "FlowBLogGroup": {
      "Type": "AWS::Logs::LogGroup",
      "DeletionPolicy": "Delete",
      "UpdateReplacePolicy": "Delete",
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "/aws/lambda/${AWS::StackName}-flow-b"
        },
        "RetentionInDays": 30
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Logs of the Flow B Lambda (P2.15), the only log group its role may write."
        }
      },
      "Condition": "DeployFlowB"
    },
    "FlowBLambdaRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "Description": "Execution role of the Flow B Lambda: the app least-privilege policy plus its own log group.",
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole",
              "Condition": {
                "StringEquals": {
                  "aws:SourceAccount": {
                    "Ref": "AWS::AccountId"
                  }
                }
              }
            }
          ]
        },
        "ManagedPolicyArns": [
          {
            "Ref": "AppAccessPolicy"
          }
        ],
        "Policies": [
          {
            "PolicyName": "FlowBLogs",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Sid": "WriteOwnLogGroup",
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogGroup",
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": [
                    {
                      "Fn::GetAtt": [
                        "FlowBLogGroup",
                        "Arn"
                      ]
                    }
                  ]
                }
              ]
            }
          }
        ]
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Reuses AppAccessPolicy (one model, one guardrail, one S3 prefix).",
          "must": [
            "No other managed policy",
            "Logs limited to FlowBLogGroup"
          ]
        }
      },
      "Condition": "DeployFlowB"
    },
    "FlowBFunction": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "FunctionName": {
          "Fn::Sub": "${AWS::StackName}-flow-b"
        },
        "Description": "CoherenceAnalyzer Flow B steps B1 to B9, one step per invocation (event step). Educational simulation, no execution.",
        "Runtime": "python3.11",
        "Handler": "coherence_analyzer.lambda_handler.handler",
        "Architectures": [
          "x86_64"
        ],
        "Code": {
          "S3Bucket": {
            "Ref": "LambdaCodeS3Bucket"
          },
          "S3Key": {
            "Ref": "LambdaCodeS3Key"
          }
        },
        "Role": {
          "Fn::GetAtt": [
            "FlowBLambdaRole",
            "Arn"
          ]
        },
        "Timeout": 900,
        "MemorySize": 2048,
        "LoggingConfig": {
          "LogGroup": {
            "Ref": "FlowBLogGroup"
          },
          "LogFormat": "Text"
        },
        "Environment": {
          "Variables": {
            "COHERENCE_ANALYZER_LLM": "live",
            "COHERENCE_ANALYZER_STORE": "s3",
            "COHERENCE_ANALYZER_S3_BUCKET": {
              "Ref": "DataBucket"
            },
            "COHERENCE_ANALYZER_S3_PREFIX": {
              "Ref": "S3Prefix"
            },
            "BEDROCK_MODEL_ID": {
              "Ref": "BedrockModelId"
            },
            "BEDROCK_GUARDRAIL_ID": {
              "Fn::GetAtt": [
                "ExplainerGuardrail",
                "GuardrailId"
              ]
            },
            "BEDROCK_GUARDRAIL_VERSION": {
              "Fn::GetAtt": [
                "ExplainerGuardrailVersion",
                "Version"
              ]
            },
            "COHERENCE_ANALYZER_RUNTIME_CACHE_DIR": "/tmp/llm-cache"
          }
        }
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "SPEC section 14: Lambda hosts the Flow B steps for Step Functions (P2.15).",
          "must": [
            "COHERENCE_ANALYZER_LLM=live, store s3",
            "The store strips the trailing slash of S3Prefix"
          ]
        }
      },
      "Condition": "DeployFlowB"
    },
    "FlowBStateMachineRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "Description": "Role of the Flow B state machine: may only invoke the Flow B Lambda.",
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "states.amazonaws.com"
              },
              "Action": "sts:AssumeRole",
              "Condition": {
                "StringEquals": {
                  "aws:SourceAccount": {
                    "Ref": "AWS::AccountId"
                  }
                }
              }
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "InvokeFlowBFunction",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Sid": "InvokeFlowBFunctionOnly",
                  "Effect": "Allow",
                  "Action": [
                    "lambda:InvokeFunction"
                  ],
                  "Resource": [
                    {
                      "Fn::GetAtt": [
                        "FlowBFunction",
                        "Arn"
                      ]
                    },
                    {
                      "Fn::Sub": "${FlowBFunction.Arn}:*"
                    }
                  ]
                }
              ]
            }
          }
        ]
      },
      "Condition": "DeployFlowB"
    },
    "FlowBStateMachine": {
      "Type": "AWS::StepFunctions::StateMachine",
      "Properties": {
        "StateMachineName": {
          "Fn::Sub": "${AWS::StackName}-flow-b"
        },
        "StateMachineType": "STANDARD",
        "RoleArn": {
          "Fn::GetAtt": [
            "FlowBStateMachineRole",
            "Arn"
          ]
        },
        "Definition": {
          "Comment": "CoherenceAnalyzer Flow B, trade check (SPEC section 4, B1 to B9). Every Task invokes the one Flow B Lambda (coherence_analyzer.lambda_handler.handler) with a step name. Educational simulation: no recommendation, no execution.",
          "StartAt": "B1 parse intent",
          "States": {
            "B1 parse intent": {
              "Type": "Task",
              "Comment": "N4 intent parser on the order_intent event text, then the draft gate.",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Parameters": {
                "FunctionName": "${FlowBFunctionArn}",
                "Payload": {
                  "step": "b1_parse_intent",
                  "fixture_dir.$": "$.fixture_dir",
                  "intent_id.$": "$.intent_id",
                  "auto_confirm.$": "$.auto_confirm"
                }
              },
              "ResultSelector": {
                "state.$": "$.Payload"
              },
              "ResultPath": "$",
              "Retry": [
                {
                  "ErrorEquals": [
                    "Lambda.ServiceException",
                    "Lambda.AWSLambdaException",
                    "Lambda.SdkClientException",
                    "Lambda.TooManyRequestsException"
                  ],
                  "IntervalSeconds": 2,
                  "MaxAttempts": 3,
                  "BackoffRate": 2,
                  "JitterStrategy": "FULL"
                }
              ],
              "Catch": [
                {
                  "ErrorEquals": [
                    "States.ALL"
                  ],
                  "ResultPath": "$.error",
                  "Next": "FlowBFailed"
                }
              ],
              "Next": "B2 confirmed?"
            },
            "B2 confirmed?": {
              "Type": "Choice",
              "Comment": "B2 confirmation: only an auto-confirmed run goes on; otherwise the run stops with the draft for the user to confirm.",
              "Choices": [
                {
                  "Variable": "$.state.auto_confirm",
                  "BooleanEquals": true,
                  "Next": "B3 refresh"
                }
              ],
              "Default": "Awaiting confirmation"
            },
            "Awaiting confirmation": {
              "Type": "Pass",
              "Comment": "Output = the draft, as pipeline.check returns it without auto_confirm. Nothing is saved.",
              "Parameters": {
                "status": "awaiting_confirmation",
                "intent_id.$": "$.state.intent_id",
                "draft.$": "$.state.draft",
                "draft_gate.$": "$.state.draft_gate",
                "intent.$": "$.state.fixture_intent",
                "event.$": "$.state.event"
              },
              "ResultPath": "$",
              "End": true
            },
            "B3 refresh": {
              "Type": "Task",
              "Comment": "Confirms the intent (fixture intent, user-declared) and runs Flow A up to the order_intent, with N1.",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Parameters": {
                "FunctionName": "${FlowBFunctionArn}",
                "Payload": {
                  "step": "b3_refresh",
                  "state.$": "$.state"
                }
              },
              "ResultSelector": {
                "state.$": "$.Payload"
              },
              "ResultPath": "$",
              "Retry": [
                {
                  "ErrorEquals": [
                    "Lambda.ServiceException",
                    "Lambda.AWSLambdaException",
                    "Lambda.SdkClientException",
                    "Lambda.TooManyRequestsException"
                  ],
                  "IntervalSeconds": 2,
                  "MaxAttempts": 3,
                  "BackoffRate": 2,
                  "JitterStrategy": "FULL"
                }
              ],
              "Catch": [
                {
                  "ErrorEquals": [
                    "States.ALL"
                  ],
                  "ResultPath": "$.error",
                  "Next": "FlowBFailed"
                }
              ],
              "Next": "B4 apply"
            },
            "B4 apply": {
              "Type": "Task",
              "Comment": "intent.apply: the proposed portfolio.",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Parameters": {
                "FunctionName": "${FlowBFunctionArn}",
                "Payload": {
                  "step": "b4_apply",
                  "state.$": "$.state"
                }
              },
              "ResultSelector": {
                "state.$": "$.Payload"
              },
              "ResultPath": "$",
              "Retry": [
                {
                  "ErrorEquals": [
                    "Lambda.ServiceException",
                    "Lambda.AWSLambdaException",
                    "Lambda.SdkClientException",
                    "Lambda.TooManyRequestsException"
                  ],
                  "IntervalSeconds": 2,
                  "MaxAttempts": 3,
                  "BackoffRate": 2,
                  "JitterStrategy": "FULL"
                }
              ],
              "Catch": [
                {
                  "ErrorEquals": [
                    "States.ALL"
                  ],
                  "ResultPath": "$.error",
                  "Next": "FlowBFailed"
                }
              ],
              "Next": "B5 analyse"
            },
            "B5 analyse": {
              "Type": "Parallel",
              "Comment": "B5: current and proposed portfolios analysed in two parallel branches.",
              "Branches": [
                {
                  "StartAt": "B5 analyse current",
                  "States": {
                    "B5 analyse current": {
                      "Type": "Task",
                      "Comment": "engine.analyse on the current portfolio (same seed and horizon on both sides); returns only the keys it adds.",
                      "Resource": "arn:aws:states:::lambda:invoke",
                      "Parameters": {
                        "FunctionName": "${FlowBFunctionArn}",
                        "Payload": {
                          "step": "b5_analyse_current",
                          "state.$": "$.state"
                        }
                      },
                      "ResultPath": "$",
                      "Retry": [
                        {
                          "ErrorEquals": [
                            "Lambda.ServiceException",
                            "Lambda.AWSLambdaException",
                            "Lambda.SdkClientException",
                            "Lambda.TooManyRequestsException"
                          ],
                          "IntervalSeconds": 2,
                          "MaxAttempts": 3,
                          "BackoffRate": 2,
                          "JitterStrategy": "FULL"
                        }
                      ],
                      "Catch": [
                        {
                          "ErrorEquals": [
                            "States.ALL"
                          ],
                          "ResultPath": "$.error",
                          "Next": "B5 current failed"
                        }
                      ],
                      "End": true,
                      "OutputPath": "$.Payload"
                    },
                    "B5 current failed": {
                      "Type": "Fail",
                      "Comment": "Carries the error of the failed step (Lambda error type and message).",
                      "ErrorPath": "$.error.Error",
                      "CausePath": "$.error.Cause"
                    }
                  }
                },
                {
                  "StartAt": "B5 analyse proposed",
                  "States": {
                    "B5 analyse proposed": {
                      "Type": "Task",
                      "Comment": "engine.analyse on the proposed portfolio (same seed and horizon on both sides); returns only the keys it adds.",
                      "Resource": "arn:aws:states:::lambda:invoke",
                      "Parameters": {
                        "FunctionName": "${FlowBFunctionArn}",
                        "Payload": {
                          "step": "b5_analyse_proposed",
                          "state.$": "$.state"
                        }
                      },
                      "ResultPath": "$",
                      "Retry": [
                        {
                          "ErrorEquals": [
                            "Lambda.ServiceException",
                            "Lambda.AWSLambdaException",
                            "Lambda.SdkClientException",
                            "Lambda.TooManyRequestsException"
                          ],
                          "IntervalSeconds": 2,
                          "MaxAttempts": 3,
                          "BackoffRate": 2,
                          "JitterStrategy": "FULL"
                        }
                      ],
                      "Catch": [
                        {
                          "ErrorEquals": [
                            "States.ALL"
                          ],
                          "ResultPath": "$.error",
                          "Next": "B5 proposed failed"
                        }
                      ],
                      "End": true,
                      "OutputPath": "$.Payload"
                    },
                    "B5 proposed failed": {
                      "Type": "Fail",
                      "Comment": "Carries the error of the failed step (Lambda error type and message).",
                      "ErrorPath": "$.error.Error",
                      "CausePath": "$.error.Cause"
                    }
                  }
                }
              ],
              "ResultPath": "$.b5",
              "Catch": [
                {
                  "ErrorEquals": [
                    "States.ALL"
                  ],
                  "ResultPath": "$.error",
                  "Next": "FlowBFailed"
                }
              ],
              "Next": "B6 checks and diff"
            },
            "B6 checks and diff": {
              "Type": "Task",
              "Comment": "Hard and soft checks on both portfolios, the diff, and has_violations.",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Parameters": {
                "FunctionName": "${FlowBFunctionArn}",
                "Payload": {
                  "step": "b6_checks_and_diff",
                  "state.$": "States.JsonMerge(States.JsonMerge($.state, $.b5[0], false), $.b5[1], false)"
                }
              },
              "ResultSelector": {
                "state.$": "$.Payload"
              },
              "ResultPath": "$",
              "Retry": [
                {
                  "ErrorEquals": [
                    "Lambda.ServiceException",
                    "Lambda.AWSLambdaException",
                    "Lambda.SdkClientException",
                    "Lambda.TooManyRequestsException"
                  ],
                  "IntervalSeconds": 2,
                  "MaxAttempts": 3,
                  "BackoffRate": 2,
                  "JitterStrategy": "FULL"
                }
              ],
              "Catch": [
                {
                  "ErrorEquals": [
                    "States.ALL"
                  ],
                  "ResultPath": "$.error",
                  "Next": "FlowBFailed"
                }
              ],
              "Next": "B7 violations?"
            },
            "B7 violations?": {
              "Type": "Choice",
              "Comment": "B7: the resizer runs only when the proposed portfolio has a hard violation.",
              "Choices": [
                {
                  "Variable": "$.state.has_violations",
                  "BooleanEquals": true,
                  "Next": "B7 resize"
                }
              ],
              "Default": "B8 explain"
            },
            "B7 resize": {
              "Type": "Task",
              "Comment": "Resizer (SPEC section 8): weights and funding modes that keep the trade within the limits.",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Parameters": {
                "FunctionName": "${FlowBFunctionArn}",
                "Payload": {
                  "step": "b7_resize",
                  "state.$": "$.state"
                }
              },
              "ResultSelector": {
                "state.$": "$.Payload"
              },
              "ResultPath": "$",
              "Retry": [
                {
                  "ErrorEquals": [
                    "Lambda.ServiceException",
                    "Lambda.AWSLambdaException",
                    "Lambda.SdkClientException",
                    "Lambda.TooManyRequestsException"
                  ],
                  "IntervalSeconds": 2,
                  "MaxAttempts": 3,
                  "BackoffRate": 2,
                  "JitterStrategy": "FULL"
