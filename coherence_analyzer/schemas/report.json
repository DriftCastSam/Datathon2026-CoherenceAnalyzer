{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coherence-analyzer.local/schemas/report.json",
  "title": "CoherenceAnalyzer report (SPEC §13, five-factor sections docs/spec-factors.md §20.4)",
  "description": "Flow C (portfolio review) reports have intent, checks_proposed, metrics_proposed and diff = null and alternatives = []. Flow B fills them (P2).",
  "type": "object",
  "required": ["run_id", "flow", "profile_id", "profile_version", "portfolio_id", "intent", "verdict", "checks_current",
               "checks_proposed", "diff", "metrics_current", "metrics_proposed", "alternatives", "unknowns",
               "assumptions", "data_window", "explanation", "disclaimer", "sections", "profile_coherence"],
  "properties": {
    "run_id": {"type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"},
    "flow": {"enum": ["A", "B", "C"]},
    "profile_id": {"type": "string", "minLength": 1},
    "profile_version": {"type": "integer", "minimum": 1},
    "portfolio_id": {"type": "string", "minLength": 1},
    "intent": {"type": ["object", "null"]},
    "verdict": {"enum": ["coherent", "coherent_with_warnings", "incoherent"]},
    "checks_current": {"type": "array", "items": {"$ref": "#/$defs/check"}},
    "checks_proposed": {"type": ["array", "null"], "items": {"$ref": "#/$defs/check"}},
    "diff": {
      "type": ["object", "null"],
      "required": ["flipped", "metrics_delta"],
      "properties": {"flipped": {"type": "array"}, "metrics_delta": {"type": "object"}}
    },
    "metrics_current": {"$ref": "#/$defs/metrics"},
    "metrics_proposed": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/metrics"}]},
    "alternatives": {"type": "array"},
    "unknowns": {"type": "array", "items": {"$ref": "#/$defs/check"}},
    "assumptions": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
    "data_window": {"type": "array", "items": {"type": "string"}, "minItems": 2, "maxItems": 2},
    "explanation": {
      "type": "object",
      "required": ["mode", "headline", "segments", "disclaimer"],
      "properties": {
        "mode": {"enum": ["llm", "llm_retry", "template"]},
        "headline": {"type": "string", "minLength": 1, "maxLength": 140},
        "segments": {"type": "array", "items": {"$ref": "#/$defs/segment", "required": ["factor"]}},
        "disclaimer": {"type": "string", "minLength": 1}
      }
    },
    "disclaimer": {"type": "string", "minLength": 1},
    "profile_coherence": {
      "description": "Internal coherence of the profile (docs/spec-factors.md 20.9): separate from the verdict; never violation (invariant 3).",
      "type": "object",
      "required": ["status", "findings"],
      "additionalProperties": false,
      "properties": {
        "status": {"enum": ["pass", "info", "warning"]},
        "findings": {"type": "array", "items": {"$ref": "#/$defs/profile_finding"}}
      }
    },
    "sections": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {"$ref": "#/$defs/section"}
    },
    "goals": {
      "description": "G1 goal probabilities (SPEC 7.3, P2.14): info only, separate from the verdict and from `limits`.",
      "type": "object",
      "required": ["monthly_contribution", "horizon_months", "goal_probs", "checks", "assumptions"],
      "properties": {
        "monthly_contribution": {"type": "number", "minimum": 0},
        "horizon_months": {"type": "integer", "minimum": 1},
        "goal_probs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "date", "amount", "month", "prob"],
            "properties": {
              "name": {"type": "string"}, "date": {"type": "string"}, "amount": {"type": "number"},
              "month": {"type": "integer", "minimum": 1}, "prob": {"type": "number", "minimum": 0, "maximum": 1}
            }
          }
        },
        "checks": {
          "type": "array",
          "items": {"allOf": [{"$ref": "#/$defs/check"},
                              {"properties": {"id": {"const": "G1"}, "status": {"const": "info"}}}]}
        },
        "assumptions": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    }
  },
  "$defs": {
    "status": {"enum": ["pass", "violation", "warning", "info", "unknown"]},
    "profile_finding": {
      "type": "object",
      "required": ["id", "source", "kind", "status", "fields", "question"],
      "properties": {
        "id": {"type": "string", "pattern": "^(C[0-9]+|N6\\.[0-9]+)$"},
        "source": {"type": "string", "pattern": "^(rule:C[0-9]+|llm:profile_consistency)$"},
        "kind": {"enum": ["tension", "contradiction"]},
        "status": {"enum": ["info", "warning"]},
        "fields": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
        "values": {"type": "array"},
        "quotes": {"type": "array", "items": {"type": "string"}},
        "reason": {"type": ["string", "null"]},
        "question": {
          "type": "object",
          "required": ["fr-CA", "en-CA"],
          "properties": {"fr-CA": {"type": "string", "minLength": 1}, "en-CA": {"type": "string", "minLength": 1}}
        }
      }
    },
    "check": {
      "type": "object",
      "required": ["id", "kind", "status", "factor", "derived_from"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Z][0-9]+$"},
        "kind": {"enum": ["hard", "soft"]},
        "status": {"$ref": "#/$defs/status"},
        "factor": {"enum": ["objectif", "horizon", "risque", "contraintes", "preferences"]},
        "subject": {"type": ["string", "null"]},
        "value": {"type": ["number", "string", "null"]},
        "limit": {"type": ["number", "string", "null"]},
        "unit": {"type": "string"},
        "derived_from": {"type": "array", "items": {"type": "string"}},
        "source": {"type": "string"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "message_key": {"type": "string"}
      },
      "allOf": [
        {"if": {"properties": {"kind": {"const": "soft"}}}, "then": {"properties": {"status": {"not": {"const": "violation"}}}}}
      ]
    },
    "metrics": {
      "type": "object",
      "required": ["vol", "mdd", "loss_prob", "width", "p5_T", "p50_T", "p95_T", "cone", "assumptions"],
      "properties": {
        "vol": {"type": "number"},
        "mdd": {"type": "number"},
        "mdd_date": {"type": "string"},
        "loss_prob": {"type": "number"},
        "width": {"type": "number"},
        "p5_T": {"type": "number"},
        "p50_T": {"type": "number"},
        "p95_T": {"type": "number"},
        "cone": {"type": "object", "required": ["p5", "p25", "p50", "p75", "p95"]},
        "assumptions": {"type": "array", "items": {"type": "string"}}
      }
    },
    "segment": {
      "type": "object",
      "required": ["kind", "text", "refs"],
      "properties": {
        "factor": {"type": "string"},
        "kind": {"enum": ["fact", "assumption", "inference", "unknown"]},
        "text": {"type": "string", "minLength": 1, "maxLength": 300},
        "refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1}
      }
    },
    "section": {
      "type": "object",
      "required": ["factor", "title", "question", "status", "checks", "unknowns", "not_covered", "facts", "narrative"],
      "properties": {
        "factor": {"enum": ["objectif", "horizon", "risque", "contraintes", "preferences"]},
        "title": {"type": "string"},
        "question": {"type": "string"},
        "status": {"$ref": "#/$defs/status"},
        "checks": {"type": "array", "items": {"type": "string"}},
        "unknowns": {"type": "array"},
        "not_covered": {"type": "array", "items": {"type": "string"}},
        "facts": {
          "type": "object",
          "required": ["factor", "locale", "status", "verdict", "intent", "declared", "derived", "checks", "metrics",
                       "evidence_events", "unknowns"]
        },
        "narrative": {
          "type": "object",
          "required": ["mode", "segments", "verify"],
          "properties": {
            "mode": {"enum": ["llm", "llm_retry", "template"]},
            "segments": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"$ref": "#/$defs/segment"}},
            "verify": {
              "type": "object",
              "required": ["passed", "failures"],
              "properties": {"passed": {"type": "boolean"}, "failures": {"type": "array", "items": {"type": "string"}}}
            }
          }
        }
      }
    }
  }
}
