{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "behaviour_classifier (N1) tool input",
  "type": "object",
  "additionalProperties": false,
  "required": ["abstain", "evidence"],
  "properties": {
    "abstain": {"type": "boolean", "description": "true when fewer than 2 relevant events; then omit value and confidence and send an empty evidence list."},
    "value": {"type": "string", "enum": ["low", "low_moderate", "moderate", "moderate_high", "high"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 0.8},
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["event_id", "signal", "note"],
        "properties": {
          "event_id": {"type": "string", "minLength": 1},
          "signal": {"type": "string", "enum": ["hype_chasing", "concentration_request", "panic_selling_intent", "loss_aversion", "overtrading", "market_timing", "long_term_framing", "diversification_request", "risk_questioning"]},
          "note": {"type": "string"}
        }
      }
    }
  },
  "if": {"properties": {"abstain": {"const": false}}},
  "then": {"required": ["value", "confidence"], "properties": {"evidence": {"minItems": 1}}}
}
