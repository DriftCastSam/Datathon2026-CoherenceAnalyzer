AWS_REGION=us-east-1
BEDROCK_MODEL_ID=
# Optional: Bedrock Guardrail on the explainer call only (both needed). From the stack outputs GuardrailId / GuardrailVersion.
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=
COHERENCE_ANALYZER_LLM=mock
# Store: local (default) or s3. For s3 set the bucket (stack output BucketName); the prefix is optional.
COHERENCE_ANALYZER_STORE=local
COHERENCE_ANALYZER_S3_BUCKET=
COHERENCE_ANALYZER_S3_PREFIX=
